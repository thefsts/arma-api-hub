{
  "name": "arma-api-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ARMA API Hub — secure shared API, event, identity, contract, webhook, and integration control plane for FSTS systems.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "secret:scan": "node scripts/secret-scan.mjs",
    "deps:check": "node scripts/dependency-check.mjs",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm secret:scan && pnpm deps:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "prettier": "3.9.8",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.7"
  }
}
