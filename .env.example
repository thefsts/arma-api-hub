# ARMA API Hub — sanitized environment template.
#
# Copy to `.env` for local development and replace every value with a LOCAL,
# SYNTHETIC placeholder. NEVER commit real credentials, tokens, signing
# secrets, private keys, webhook secrets, or production endpoints.
#
# `.env` files are git-ignored. Only this `.env.example` is tracked.

# --- Runtime ---
NODE_ENV=development
API_HUB_ENV=development

# --- Service-facing API ---
API_HUB_API_PORT=8080
API_HUB_API_BASE_URL=http://localhost:8080

# --- Management console ---
API_HUB_CONSOLE_PORT=3000
API_HUB_CONSOLE_BASE_URL=http://localhost:3000

# --- Durable worker ---
API_HUB_WORKER_CONCURRENCY=4
API_HUB_WORKER_POLL_INTERVAL_MS=1000

# --- Database (local development only) ---
# Use a local, disposable database. Never point this at production.
DATABASE_URL=postgres://api_hub:local_dev_only@localhost:5432/api_hub_dev

# --- Queue / broker (local development only) ---
QUEUE_URL=redis://localhost:6379/0

# --- Signing / crypto (LOCAL SYNTHETIC VALUES ONLY) ---
# These are placeholders. Real key material is provisioned through the
# secrets manager and never stored in the repository.
API_HUB_SIGNING_KEY_ID=local-dev-key-0001
API_HUB_SIGNING_ALGORITHM=HMAC-SHA256
API_HUB_SIGNING_SECRET=replace-with-local-synthetic-secret

# --- Observability ---
API_HUB_LOG_LEVEL=debug
API_HUB_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Kill switches (fail-closed defaults) ---
API_HUB_OUTBOUND_DELIVERY_DISABLED=true
API_HUB_CONNECTOR_DELIVERY_DISABLED=true

# --- Convex authorization (Phase 0) ---
# The trusted issuer for server-derived authorization. A caller is
# authenticated only when its identity originates from this issuer. When this
# value is unset the authorization layer fails closed: no caller is ever
# considered authenticated. See docs/security/ADR-0005-authentication-decision.md.
# Leave unset in Phase 0 (no human identity provider is approved yet).
ARMA_TRUSTED_ISSUER=

# --- Convex (ARMA API HUB project) ---
# Placeholder variable names only. Real values live in `.env.local`, which is
# git-ignored and never committed. Do not commit deployment credentials,
# access tokens, or deploy keys.
CONVEX_DEPLOYMENT=dev:placeholder-deployment
CONVEX_URL=https://placeholder-deployment.convex.cloud
CONVEX_SITE_URL=https://placeholder-deployment.convex.site
