{
 "description": "Health / readiness contract. HEALTHY != COMPLIANT and READY != CERTIFIED: these are operational signals about whether the service boundary can process governed requests, never whether any tenant, product, or control is compliant. Both reports carry complianceClaim=NONE and certificationClaim=NONE.",
 "referenceDate": "2026-09-16",
 "health": {
  "query": "service.complianceServiceHealth",
